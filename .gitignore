# =============================================================================
# Python
# =============================================================================
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# =============================================================================
# 数据与权重（体积大或含隐私，可由脚本重建）
#
# 注意：git 的 .gitignore **不支持行内注释**——"pattern  # 注释" 会被整行当作模式。
# 因此所有说明都单独成行，绝不写在模式后面。
#
# 这里只使用“显式排除”规则，不使用 ! 取反：
# 目录一旦被排除，git 不会进入该目录，目录内的 ! 取反规则会失效，
# 容易被误解成“白名单生效了”。官方 README 存档因此放在 docs/ 而不是 data/。
# =============================================================================

# CCPD 真实车牌原图 —— 永远不得提交（含隐私）
data/ccpd/

# 合成域测试图（体积大，可由 generator 重建）
data/synth_test/
data/synth_test_preview/

# 预处理缓存 .npy / .npz（可由预处理脚本重建）
data/processed/

# 剪裁后的图片 PNG（是缓存的逐张可视化副本，可由预处理脚本重建，体积大）
data/crops/
data/**/crops/

# 下载压缩包临时目录（可达数 GB，绝不入库）
data/raw_dl/

# 数据清单由脚本重建
data/manifest.csv
data/manifest_synth.csv
data/manifest_hard.csv

# 模型权重与图表：最终交付权重入库，其余（临时/冒烟/中间轮次）不入库
reports/checkpoints/*
!reports/checkpoints/final_s*
reports/figs/

# 后台任务的运行日志（过程性输出，不是结论证据）
reports/logs/_job*.log

# 一次性重测脚本的运行日志（过程性输出）
reports/logs/_refresh_synth.log

# CuPy JIT 头文件缓存（运行时生成，正常落在 %TEMP%；若 TMPDIR 异常会落到工作区）
projectx_cupy_inc/

# 外部生成器仓库（合成域测试集来源；由 clone 重建，固定 commit 见 README §3.1）
data/external/

# 参考仓库（临时核对用）
_ref/

# 本地临时目录（pip 沙盒绕行等）
.tmp/
.acl-recovery/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini

# 提交信息临时文件（绝不入库）
.gitmsg*.txt